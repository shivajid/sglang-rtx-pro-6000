+// Kimi-K3 SiTU (SoftCap-GLU) activation. gate_out = situ_beta*tanh(gate/situ_beta)*sigmoid(gate),
+// up_out = situ_linear_beta*tanh(up/situ_linear_beta), out = gate_out*up_out. SGLang passes situ_beta
+// in swiglu_alpha and situ_linear_beta in swiglu_beta, so `alpha` = gate softcap and `beta` = up
+// softcap. No external clamp limit: the tanh softcaps bound the output, so `limit` stays at
+// infinity and is unused (doActivationKernel only overrides fn.limit when a swiglu_limit tensor is
+// supplied, which SGLang leaves None for SiTU). Formula matches SGLang's kimi_k3/situ_and_mul.cuh.
+struct SituAdaptor {
+  constexpr static bool IS_GLU = true;
+  float alpha = 4.0f;  // situ_beta (gate softcap)
+  float beta = 25.0f;  // situ_linear_beta (up softcap)
+  float limit = std::numeric_limits<float>::infinity();  // unused
+
+  template <class T>
+  __device__ T operator()(T const& gate, T const& linear) const {
+    // T is a vectorized cutlass::Array<float, N> fragment (N = 4/8/16/32) in the gated kernel, or a
+    // scalar float in the elementwise kernel. CUTLASS provides Array specializations of Tanh and
+    // Sigmoid and scalar*Array / Array*Array operators, but NOT Array/scalar division, so the
+    // softcap x/beta is written as beta * tanh(x * (1/beta)) with a float reciprocal.
+    cutlass::epilogue::thread::Sigmoid<T> sigmoid{};
+    cutlass::epilogue::thread::Tanh<T> tanh{};
+    float const inv_alpha = 1.0f / alpha;
+    float const inv_beta = 1.0f / beta;
+    T const gate_out = alpha * tanh(gate * inv_alpha) * sigmoid(gate);
+    T const up_out = beta * tanh(linear * inv_beta);
+    return gate_out * up_out;
+  }
+};
+
